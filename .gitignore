# pyenv
#   For a library or app, you might want to share your .python-version if you're
#   using tools like pipenv or poetry, so that version can be recreated.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or fail
#   to install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions, but may contain platform-specific
#   dependencies or dependecies without cross-platform support.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions
.pdm-plugins/
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

